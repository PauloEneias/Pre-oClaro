      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="2fa5ce41-0bff-45cd-873d-fd53b23fefd4"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Relevância antes da paginação: o ranking ordena todos os candidatos e só então corta a página. Depois o serviço busca ofertas e fotos apenas dos GTINs da página e calcula os preços em centavos.]]></ATT>
