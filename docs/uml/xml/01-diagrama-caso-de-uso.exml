      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="c757d7b2-b61a-44de-b4e5-edf868b7fb2c"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Visitante: usa tudo sem conta (as listas ficam no navegador). Usuário autenticado: herda os casos do visitante e ganha os que exigem sessão. «include»: a base sempre executa o incluído. «extend»: o caso opcional estende a base. Não há administrador: manutenção e coleta manual são scripts de linha de comando.]]></ATT>
            <ATT name="MimeType"></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
