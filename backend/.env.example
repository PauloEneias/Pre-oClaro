# Copie para backend/.env e adapte com os dados do SEU MySQL (não envie a senha ao GitHub).
PORT=3001
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=precoclaro

# Serviço de estabelecimentos OSM (necessita internet; opcional personalizar):
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# OPCIONAL: API licenciada de preços online; mantenha a chave somente no back-end.
DATA_MARKET_API_KEY=
# Ativar somente após conferir cotas, cobertura e condições do seu plano:
MARKET_SYNC_ENABLED=false
MARKET_SYNC_EANS=7896006711155
MARKET_SYNC_INTERVAL_HOURS=24

# COLETA AUTOMÁTICA DE PREÇOS nos sites das redes — ver COLETA-AUTOMATICA.md
# Intervalo entre coletas completas, em horas:
PRICE_COLLECT_INTERVAL_HOURS=12
# Atacadão São Luís: ligado por padrão. Use false para desligar.
ATACADAO_SYNC_ENABLED=true
ATACADAO_STORE_SLUG=sao-luis
# Mateus Mais: funciona tecnicamente, mas os Termos de Uso do site vedam scripts de coleta.
# Ligar (true) é decisão e risco de quem opera o projeto.
MATEUS_SYNC_ENABLED=false
# Opcional: limitar unidades (slugs separados por vírgula) e o total de consultas por execução.
MATEUS_MARKETS=
MATEUS_MAX_REQUESTS=4000
# Pausa mínima entre requisições ao mesmo site (milissegundos):
MARKET_REQUEST_DELAY_MS=1500
# false desliga toda a coleta nos sites (o banco mantém os últimos preços válidos):
LIVE_SCRAPE_ENABLED=true

# ---------------------------------------------------------------------------
# PRODUÇÃO (hospedagem). Em desenvolvimento nada disto precisa ser definido.
# ---------------------------------------------------------------------------
# NODE_ENV=production faz a API escutar em 0.0.0.0, exigir cookie Secure e
# deixar os coletores fora do processo da API.
NODE_ENV=development
# Domínios do front-end autorizados (separados por vírgula). Em produção, só o seu:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cookie de sessão: lax quando front e API estão no mesmo site; none quando
# ficam em domínios diferentes (exige HTTPS).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true   (padrão em produção)
SESSION_DAYS=30
# Coletores no mesmo processo da API? Padrão: true em desenvolvimento, false em produção
# (em produção rode "npm run worker:prod" num processo separado).
# RUN_COLLECTORS_IN_API=false
# Pasta dos anexos do Conferir Caixa. Em hospedagem, aponte para um disco persistente.
UPLOADS_DIR=uploads
# MySQL remoto com TLS:
# DB_SSL=true
# DB_POOL_SIZE=8
